# Copy to .env and fill in. Placeholders only in this file - it is committed.

# ---- the one switch between the deployed stack and the local standby --------
# Deployed:  https://<your-alb-dns-name>
# Standby:   http://localhost:4000
# This single variable is the stage fallback AND the live demonstration of
# slide 6's reversibility argument. Nothing else changes.
GATEWAY_BASE_URL=http://localhost:4000

# ---- gateway ---------------------------------------------------------------
LITELLM_MASTER_KEY=sk-replace-me
DATABASE_URL=postgresql://litellm:replace-me@localhost:5432/litellm
REDIS_HOST=localhost
REDIS_PORT=6379

# ---- AWS -------------------------------------------------------------------
AWS_REGION=eu-central-1
AWS_PROFILE=awsday

# ---- Bedrock model IDs -----------------------------------------------------
# bootstrap.sh verifies every one of these against the live account.
MODEL_CLAUDE_SONNET=anthropic.claude-sonnet-4-5-20250929-v1:0
MODEL_GPT=openai.gpt-5-6-20260817-v1:0
MODEL_NOVA_LITE=amazon.nova-lite-v1:0
MODEL_JUDGE=amazon.nova-micro-v1:0

# ---- Intelligent Prompt Router ARNs ----------------------------------------
# Written by infra/bootstrap.sh from `aws bedrock create-prompt-router`.
# Left blank here on purpose: an ARN contains the account ID.
IPR_CLAUDE_ARN=
IPR_NOVA_ARN=

# ---- router tuning ---------------------------------------------------------
# gamma: the cost/quality dial. score = theta / (cost ** gamma).
#   0.0 = ignore cost entirely, 1.0 = strongly cost-biased.
ROUTER_GAMMA=0.35
# lambda: decay. Applied every DECAY_EVERY requests so old beliefs fade and the
# router can change its mind. Without this Demo 4's re-sort is invisible.
ROUTER_DECAY_LAMBDA=0.985
ROUTER_DECAY_EVERY=25
# Fraction of requests the judge scores. Bounded evaluation cost.
JUDGE_SAMPLE_RATE=0.30
JUDGE_SCORE_THRESHOLD=0.7
ROUTER_LATENCY_SLA_MS=12000
# learn = posteriors update in the request path (the demo)
# snapshot = frozen policy loaded from disk, deterministic serving (production)
ROUTER_MODE=learn
ROUTER_SHADOW=false

# ---- dashboard -------------------------------------------------------------
DASHBOARD_PORT=8080
# Pin the exact Amplify origin, never '*'.
DASHBOARD_CORS_ORIGIN=https://main.replace-me.amplifyapp.com
