# Copy to .env.local. Server-side only - Next.js never ships a variable
# without the NEXT_PUBLIC_ prefix to the browser, which is the whole reason
# this app has a server side at all.
GATEWAY_BASE_URL=https://<your-cloudfront-domain>
DASHBOARD_BASE_URL=https://<your-cloudfront-domain>/dash
LITELLM_MASTER_KEY=<your master key>
